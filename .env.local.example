REVALIDATION_SECRET=
NEXT_PUBLIC_APP_URL=https://app.conagentes.com
NEXT_PUBLIC_SITE_URL=https://conagentes.com

# Demo-request forwarding into the main app (CON-262).
# Both MUST be set or forwardToHq() short-circuits and the submission never
# becomes a lead in Conagentes HQ — it only lands in demo_requests + the email.
# DEMO_REQUEST_WEBHOOK_SECRET must equal the value of the same name in the main
# app's environment (Railway).
CONAGENTES_APP_URL=https://app.conagentes.com
DEMO_REQUEST_WEBHOOK_SECRET=
